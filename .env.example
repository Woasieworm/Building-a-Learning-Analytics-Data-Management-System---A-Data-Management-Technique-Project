# Copy this file to .env and fill in real values. .env itself is gitignored.

# PostgreSQL password for the afilearn_admin role, used by:
#   04_NoSQL/build_nosql.py, 07_Orchestration/orchestrator.py,
#   08_Backup/backup.ps1, 03_ETL_Pipeline/pipeline.py (via psql)
PGPASSWORD=your_postgres_password_here

# Role passwords referenced in 02_SQL_Scripts/05_security_idempotent.sql
# (set directly in that file before running it — Postgres has no native
# way to read role-creation passwords from the environment)
ANALYST_ROLE_PASSWORD=your_analyst_role_password_here
DPO_ROLE_PASSWORD=your_dpo_role_password_here
